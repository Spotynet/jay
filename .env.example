# Secrets only (gitignored as backend/.env). Domains come from ./dev.sh / ./deploy.sh.

DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/jay_db

# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS / EXPO_PUBLIC_API_URL are set by
# ./dev.sh and ./deploy.sh from the domains defined in those scripts.
# You may still set them here; Compose `environment` from the scripts wins when deployed via those commands.
