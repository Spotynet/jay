# Jay project nginx — hostnames from env (set in dev.sh / deploy.sh).
# Official nginx image runs envsubst on /etc/nginx/templates/*.template
# Defaults (compose.yaml): jay-dev.spotynet.com / jay-api-dev.spotynet.com

# Frontend (Expo web)
server {
    listen 80;
    server_name ${JAY_WEB_HOST};

    location / {
        proxy_pass http://mobile:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# API (Django)
server {
    listen 80;
    server_name ${JAY_API_HOST};

    client_max_body_size 50m;

    location / {
        proxy_pass http://api:3012;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Local curls without a Host header (defaults to Expo web)
server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://mobile:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
