{
  "name": "expo-dev-client",
  "version": "58.0.17",
  "description": "Expo Development Client",
  "keywords": [
    "expo",
    "expo-dev-client",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/dev-client/",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-dev-client"
  },
  "main": "build/DevClient.js",
  "types": "build/DevClient.d.ts",
  "dependencies": {
    "expo-dev-launcher": "~58.0.17",
    "expo-dev-menu": "~58.0.12",
    "expo-dev-menu-interface": "~58.0.1",
    "expo-manifests": "~58.0.1",
    "expo-updates-interface": "~58.0.1"
  },
  "devDependencies": {
    "@expo/internal-scripts": "58.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "expo-test-runner": "0.6.1"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:plugin",
    "build:lib": "expo-build src",
    "build:plugin": "expo-build --base plugin cjs:src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "e2e": "expo-test-runner run-test -t e2e",
    "latest-e2e": "expo-test-runner run-test -t latest-e2e",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -b tsconfig.all.json"
  }
}