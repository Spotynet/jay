{
  "name": "expo-application",
  "version": "58.1.2",
  "description": "A universal module that gets native application information such as its ID, app name, and build version at runtime",
  "keywords": [
    "expo",
    "expo-application",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/application/",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-application"
  },
  "main": "build/Application.js",
  "types": "build/Application.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/Application.ts",
        "default": "./build/Application.d.ts"
      },
      "expo-source": "./src/Application.ts",
      "default": "./build/Application.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@expo/internal-scripts": "58.0.3",
    "expo": "58.0.13",
    "expo-modules-cli": "0.3.0"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "scripts": {
    "precompile-android": "et prebuild-android-package-for-publish",
    "build": "expo-build src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "swift:format": "../../scripts/swift-format.sh",
    "swift:lint": "../../scripts/swift-format.sh --lint",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json",
    "generate-types": "expo-modules generate-types"
  }
}