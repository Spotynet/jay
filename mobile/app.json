{
  "expo": {
    "name": "JAY",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/jay1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/jay1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotynet.jayapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/jay1.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/jay1.png",
      "name": "JAY",
      "shortName": "JAY",
      "description": "Just A Day — one day at a time",
      "backgroundColor": "#000000",
      "themeColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "icon": "./assets/jay1.png"
    },
    "extra": {
      "eas": {
        "projectId": "ef1863cf-5832-4be7-8a97-146bceb5df55"
      }
    },
    "owner": "jdtorreserazo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ef1863cf-5832-4be7-8a97-146bceb5df55"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ]
  }
}
