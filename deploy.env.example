# Copy to deploy.env (gitignored) on builder and prod hosts.
#   cp deploy.env.example deploy.env
#
# Non-secret ECR / deploy config only. Do NOT put AWS access keys here —
# use an EC2 instance role (or ambient AWS creds) for ECR push/pull.
# App secrets stay in backend/.env.

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Derived automatically if unset:
# JAY_IMAGE_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/apps/jay
# Optional overrides:
# JAY_IMAGE_PREFIX=apps/jay
# JAY_IMAGE_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/apps/jay

# deploy.sh default floating tag = git default branch (this repo: main)
JAY_IMAGE_TAG=main

# Optional domain overrides for deploy.sh
# JAY_WEB_HOST=jay.spotynet.com
# JAY_API_HOST=jay-api.spotynet.com
